# fussC house style: tabs for indentation (8 wide), Linux-kernel brace style
# (function opening brace on its own line, control braces on the same line),
# 80-column lines, pointers bind to the name. The format CI job is advisory.
BasedOnStyle: LLVM
IndentWidth: 8
TabWidth: 8
UseTab: ForIndentation
BreakBeforeBraces: Linux
ColumnLimit: 80
PointerAlignment: Right
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false
IndentCaseLabels: false
SpaceAfterCStyleCast: false
